pipeline {
    agent any

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        IMAGE_NAME = "nishantbadhiye07/shopverse-frontend"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Nishantbadhiye/shopverse.git'
            }
        }

        stage('Sonarqube Analysis') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv('sonar-server') {
                        sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                          -Dsonar.projectName=shopverse-frontend \
                          -Dsonar.projectKey=shopverse-frontend
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('frontend') {
                    sh '''
                    trivy fs --format table -o trivyfs.txt .
                    '''
                }
            }
        }

        stage('Build and Push Image') {
            steps {
                script {
                    env.IMAGE_TAG = "build-${BUILD_NUMBER}"

                    dir('frontend') {
                        withCredentials([usernamePassword(
                            credentialsId: 'docker-cred',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {

                            sh """
                            docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                            docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest

                            echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin

                            docker push ${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${IMAGE_NAME}:latest

                            docker logout
                            """
                        }
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                trivy image --format table ${IMAGE_NAME}:${IMAGE_TAG} > trivyimage.txt
                """
            }
        }

        stage('Update Deployment Manifest') {
            steps {
                dir('Kubernetes-Manifests-file/Frontend') {

                    withCredentials([usernamePassword(
                        credentialsId: 'github-cred',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )]) {

                        sh """
                        git config user.name "Nishantbadhiye"
                        git config user.email "nishantbadhiye09@gmail.com"

                        sed -i 's|image: .*|image: ${IMAGE_NAME}:${IMAGE_TAG}|g' deployment.yaml

                        git add deployment.yaml
                        git commit -m "Update frontend image to ${IMAGE_TAG}" || true

                        git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/Nishantbadhiye/shopverse.git

                        git push origin main
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            mail(
                to: "nishantbadhiye07@gmail.com",
                subject: "Pipeline Status: ${currentBuild.currentResult}",
                body: """
Jenkins Pipeline Notification

Build Status : ${currentBuild.currentResult}
Build Number : ${env.BUILD_NUMBER}
Job Name     : ${env.JOB_NAME}

Build URL:
${env.BUILD_URL}

Regards,
Jenkins CI/CD
"""
            )
        }
    }
}
